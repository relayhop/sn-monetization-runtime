"""
Proof-of-Work Build: Structural Engineering Load & Beam Deflection Analyzer
Territory: Construction_and_Engineering
Item: 1593928 - Show Your Build Weekly #5: Post Your Proof-of-Work
"""

from dataclasses import dataclass
from typing import Dict, List, Tuple
import hashlib
import json
import math
import time


@dataclass
class BeamMaterial:
    name: str
    elastic_modulus_gpa: float  # E in GPa
    yield_strength_mpa: float   # Yield strength in MPa
    density_kg_m3: float        # Density in kg/m^3

    @property
    def elastic_modulus_pa(self) -> float:
        return self.elastic_modulus_gpa * 1e9

    @property
    def yield_strength_pa(self) -> float:
        return self.yield_strength_mpa * 1e6


# Standard Engineering Materials
MATERIALS: Dict[str, BeamMaterial] = {
    "A36_STEEL": BeamMaterial("ASTM A36 Carbon Steel", 200.0, 250.0, 7850.0),
    "AL_6061_T6": BeamMaterial("Aluminum 6061-T6", 68.9, 276.0, 2700.0),
    "STRUCTURAL_TIMBER": BeamMaterial("Douglas Fir (Select)", 12.0, 34.5, 530.0),
}


class StructuralBeam:
    """
    Euler-Bernoulli Beam Deflection & Stress Analysis Engine.
    Evaluates simply supported beams subject to point loads and uniformly distributed loads (UDL).
    """

    def __init__(self, length_m: float, width_m: float, height_m: float, material: BeamMaterial):
        self.length = length_m
        self.width = width_m
        self.height = height_m
        self.material = material

    @property
    def cross_section_area(self) -> float:
        return self.width * self.height

    @property
    def second_moment_of_area(self) -> float:
        """Second moment of area (I) for rectangular cross section: (b * h^3) / 12."""
        return (self.width * (self.height ** 3)) / 12.0

    @property
    def self_weight_udl(self) -> float:
        """Self-weight load per unit length (N/m)."""
        gravity = 9.80665
        return self.cross_section_area * self.material.density_kg_m3 * gravity

    def analyze(self, point_load_n: float = 0.0, load_position_m: float = None,
                applied_udl_n_m: float = 0.0) -> Dict[str, float]:
        """
        Calculates maximum bending moment, maximum bending stress,
        maximum deflection, and Safety Factor (SF).
        """
        l = self.length
        e = self.material.elastic_modulus_pa
        i = self.second_moment_of_area
        total_udl = self.self_weight_udl + applied_udl_n_m

        # Midpoint load default
        if load_position_m is None:
            load_position_m = l / 2.0
        a = load_position_m
        b = l - a

        # Reactions at supports A and B
        r_a = (point_load_n * b / l) + (total_udl * l / 2.0)
        r_b = (point_load_n * a / l) + (total_udl * l / 2.0)

        # Moment calculations
        # Max moment from point load at x = a
        m_point = (point_load_n * a * b) / l if l > 0 else 0.0
        # Max moment from UDL at mid-span
        m_udl = (total_udl * (l ** 2)) / 8.0
        m_max = m_point + m_udl

        # Maximum bending stress: sigma = (M * c) / I, where c = h / 2
        c = self.height / 2.0
        sigma_max = (m_max * c) / i if i > 0 else float("inf")

        # Maximum deflection at mid-span (approximate superposition)
        # Point load center: (P * L^3) / (48 * E * I)
        delta_point = (point_load_n * (l ** 3)) / (48.0 * e * i) if (e * i) > 0 else 0.0
        # UDL center: (5 * w * L^4) / (384 * E * I)
        delta_udl = (5.0 * total_udl * (l ** 4)) / (384.0 * e * i) if (e * i) > 0 else 0.0
        delta_max = delta_point + delta_udl

        # Safety Factor against yield
        safety_factor = self.material.yield_strength_pa / sigma_max if sigma_max > 0 else float("inf")

        return {
            "length_m": round(l, 4),
            "moment_of_inertia_m4": round(i, 8),
            "total_udl_n_m": round(total_udl, 2),
            "support_reaction_a_n": round(r_a, 2),
            "support_reaction_b_n": round(r_b, 2),
            "max_bending_moment_nm": round(m_max, 2),
            "max_bending_stress_mpa": round(sigma_max / 1e6, 2),
            "max_deflection_mm": round(delta_max * 1e3, 3),
            "deflection_ratio": f"L/{int(round(l / delta_max))}" if delta_max > 0 else "N/A",
            "safety_factor": round(safety_factor, 2),
            "structurally_adequate": safety_factor >= 1.5,
        }


class ProofOfWorkBuilder:
    """
    Generates verifiable cryptographic proof of work attached to structural build computations.
    """

    @staticmethod
    def compute_pow(data: dict, target_difficulty: int = 4) -> Tuple[str, int, float]:
        prefix = "0" * target_difficulty
        nonce = 0
        payload_bytes = json.dumps(data, sort_keys=True).encode("utf-8")
        start = time.time()

        while True:
            candidate = hashlib.sha256(payload_bytes + str(nonce).encode("utf-8")).hexdigest()
            if candidate.startswith(prefix):
                elapsed = time.time() - start
                return candidate, nonce, elapsed
            nonce += 1


def run_proof_of_work_build():
    beam = StructuralBeam(
        length_m=6.0,
        width_m=0.15,
        height_m=0.30,
        material=MATERIALS["A36_STEEL"]
    )

    analysis_results = beam.analyze(
        point_load_n=15000.0,      # 15 kN center load
        applied_udl_n_m=2500.0     # 2.5 kN/m distributed load
    )

    payload = {
        "event": "Show Your Build Weekly #5: Post Your Proof-of-Work",
        "sub": "Construction_and_Engineering",
        "bounty_item_id": 1593928,
        "material": beam.material.name,
        "analysis": analysis_results
    }

    pow_hash, nonce, duration = ProofOfWorkBuilder.compute_pow(payload, target_difficulty=4)
    payload["proof_of_work"] = {
        "hash": pow_hash,
        "nonce": nonce,
        "computation_time_sec": round(duration, 4)
    }

    return payload


if __name__ == "__main__":
    result = run_proof_of_work_build()
    print(json.dumps(result, indent=2))
